APP_NAME=PequenaVia
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=54320
DB_DATABASE=pequenavia
DB_USERNAME=pequenavia
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=pequenavia
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=modelos-certificado
AWS_ENDPOINT=http://127.0.0.1:9010
AWS_USE_PATH_STYLE_ENDPOINT=true

VITE_APP_NAME="${APP_NAME}"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=/auth/google/callback

# --- Produção (valores reais ficam na stack, nunca no repositório) ---
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://certificados.pequenavia.app.br
# LOG_CHANNEL=stderr
# LOG_LEVEL=info
# DB_HOST=postgres
# DB_PORT=5432
# AWS_ENDPOINT=http://rustfs:9000
# GOOGLE_REDIRECT_URI=https://certificados.pequenavia.app.br/auth/google/callback
# MAIL_MAILER=smtp  (e-mail de verificação e de redefinição de senha precisam de SMTP real)

# Assistente de IA (OpenRouter). Deixe a chave vazia para desligar o assistente.
OPENROUTER_API_KEY=
ASSISTENTE_MODELO=anthropic/claude-haiku-5.5
